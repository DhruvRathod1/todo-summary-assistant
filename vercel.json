{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "public" }
    },
    {
      "src": "backend/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/summarize", "dest": "backend/index.ts" },
    { "src": "/todos",     "dest": "backend/index.ts" },
    { "src": "/health",    "dest": "backend/index.ts" },
    { "src": "/(.*)",      "dest": "public/$1" }
  ]
}